/** Reuse a retained research artifact and run the remaining real opposition generation in its isolated QA workspace. */
import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {createHash} from 'node:crypto';
import {crearServidor} from '../server/index';import {Almacen} from '../server/store';import {Cola} from '../server/agents/cola';import {Flujo} from '../server/flujo';import {applyProgrammeResearch,programmeIssues} from '../shared/teachingProgramme';
if(!process.argv.includes('--run-live'))throw Error('Pass --run-live to authorize the remaining actual model call.');
const root=path.resolve('output/programme-live-validation-2026-10-19'),receipt=JSON.parse(await fs.readFile(path.join(root,'live-receipt-opposition.json'),'utf8')),entry=receipt.cases[0];
const directory=await fs.realpath(receipt.directory);if(path.dirname(directory)!==await fs.realpath(os.tmpdir())||!path.basename(directory).startsWith('apuntes-live-programmes-'))throw Error('Not an isolated QA workspace.');
const storage=new Almacen(path.join(directory,'data'));await storage.iniciar();const queue=new Cola(1,path.join(directory,'qa-reprocessing'));
const flow=new Flujo({almacen:()=>storage,cola:queue,dirBin:path.resolve('resources-bin/win'),ajustes:()=>({carpetaDatos:storage.raiz,maxSimultaneos:1,motorPorDefecto:'claude',asistenteCompletado:true,agentes:{}}),motoresListos:()=>new Set()});
const record=JSON.parse(await fs.readFile(path.join(directory,'jobs',entry.researchJob.id+'.json'),'utf8')),resultPath=path.join(storage.dirAsignatura(entry.subjectId),record.peticion.post.datos.output),raw=await fs.readFile(path.join(root,'opposition-research-raw.json'));
await fs.mkdir(path.dirname(resultPath),{recursive:true});await fs.writeFile(resultPath,raw);await (flow as any).postprocesar(record.trabajo,record.peticion.post);await queue.flush();
const server=await crearServidor({archivoAjustes:path.join(directory,'settings.json'),carpetaDatosPorDefecto:storage.raiz,dirTrabajos:path.join(directory,'continuation-jobs'),dirEstatico:path.resolve('dist-web'),dirBin:path.resolve('resources-bin/win'),codexUsageReader:async()=>({windows:[],updatedAt:0,unavailable:true})});
const log:any={directory,server:server.url,researchRecovery:'The original real model wrote its result to a misspelled sibling path. Its retained JSON bytes were copied to the job-owned expected path and passed unchanged through current validation. No new research call.',researchSha256:createHash('sha256').update(raw).digest('hex'),cases:[]};const persist=()=>fs.writeFile(path.join(root,'opposition-continuation.json'),JSON.stringify(log,null,2));
const route=`/api/asignaturas/${entry.subjectId}/programaciones/${entry.projectId}`;
const request=async(method:string,suffix:string,body?:unknown)=>{const response=await fetch(server.url+suffix,{method,headers:body===undefined?undefined:{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});const result=await response.json();if(!response.ok)throw Error(JSON.stringify(result));return result;};
try{
 let response=await request('GET',route+'?purpose=opposition');const programme=applyProgrammeResearch(response.state.draft,response.research.result,response.research.revision);const saved=await request('PUT',route+'?purpose=opposition',{programme,expectedRevision:response.state.revision});
 const job=await request('POST',route+'/generar?purpose=opposition',{expectedRevision:saved.revision,instructions:'Respeta al menos 15 unidades numeradas y las 105 horas aportadas. Cubre todos los criterios y saberes del currículo de partida y redacta actividades completas. Describe las limitaciones de ese currículo, la convocatoria histórica de 2026 elegida y las decisiones pendientes. No inventes atribución docente ni un certificado de cumplimiento.'});
 let started=Date.now(),last=0;console.log(JSON.stringify({phase:'opposition-generation',jobId:job.id,url:server.url}));await persist();
 while(Date.now()-started<15*60_000){const current=await request('GET','/api/trabajos/'+job.id);if(!['en-cola','ejecutando'].includes(current.estado)){log.job=current;break}if(Date.now()-last>30000){console.log(JSON.stringify({phase:'opposition-generation',elapsed:Math.round((Date.now()-started)/1000),last:current.eventos?.at(-1)?.texto?.slice(0,150)}));last=Date.now()}await new Promise(resolve=>setTimeout(resolve,1500))}
 if(!log.job||log.job.estado!=='ok')throw Error(log.job?.resultado||'Generation timed out.');
 response=await request('GET',route+'?purpose=opposition');log.issues=programmeIssues(response.state.draft,response.curriculum);log.units=response.state.draft.units.length;log.activities=response.state.draft.units.reduce((n:number,u:any)=>n+(u.activityPlan?.length||0),0);await fs.writeFile(path.join(root,'opposition-programme.json'),JSON.stringify(response,null,2));
 for(const format of ['md','pdf','docx','odt']){const result=await fetch(server.url+route+'/exportar?purpose=opposition&format='+format);if(!result.ok)throw Error(await result.text());await fs.writeFile(path.join(root,'opposition-programme.'+format),Buffer.from(await result.arrayBuffer()));}
 console.log(JSON.stringify({phase:'opposition-complete',issues:log.issues,units:log.units,activities:log.activities}));
}catch(error){log.error=String(error);console.log(JSON.stringify({error:log.error}));}finally{log.finishedAt=new Date().toISOString();await persist();await server.cerrar();}
