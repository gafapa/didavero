{
  "name": "didavero",
  "productName": "Didavero",
  "version": "0.7.0-beta.1",
  "description": "Create curriculum-linked notes, exams and teaching programmes with configurable AI agents",
  "author": "Pablo Gallego",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "dev:electron": "npm run build && electron .",
    "build:web": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:web && npm run build:main",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "fetch-bin": "node scripts/fetch-bin.mjs",
    "dist": "npm run build && npm run fetch-bin && electron-builder",
    "start": "npm run build && electron .",
    "dist:portable": "npm run build && npm run fetch-bin -- win && electron-builder --win portable",
    "dist:publicar": "npm run build && npm run fetch-bin && electron-builder --publish always",
    "app": "node scripts/app-en-vivo.mjs",
    "catalogo:fp": "node scripts/catalogo-fp.mjs",
    "iconos": "electron scripts/iconos.mjs",
    "datos-mapas": "node scripts/datos-mapas.mjs",
    "build:site": "node website/build.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "abcjs": "^6.7.1",
    "algebrite": "^1.4.0",
    "d3-composite-projections": "^2.0.0",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "es-atlas": "^0.6.0",
    "fastify": "^5.12.5",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mhchemparser": "^4.2.1",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "smiles-drawer": "^2.4.1",
    "topojson-client": "^3.1.0",
    "tree-kill": "^1.2.2",
    "undici": "^8.11.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "geotiff": "^2.1.3",
    "jpeg-js": "^0.4.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    },
    "katex": "$katex"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "electron@44.7.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gafapa/didavero.git"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
